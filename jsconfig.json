{
  "compilerOptions": {
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "moduleDetection": "force",
    "target": "ES2023",
    "jsx": "react",
    "allowImportingTsExtensions": false,
    "checkJs": true,
    "strictNullChecks": true,
    "allowJs": true,
    "strictFunctionTypes": true,
    "lib": [
      "DOM",
      "ESNext"
    ],
    "paths": {
      "@ixfx/*": [
        "../node_modules/ixfx/dist/*"
      ]
    }
  },
  "include": [
    "./**/*.d.ts",
    "./**/*.js"
  ]
}