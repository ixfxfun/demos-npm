{
  "compilerOptions": {
    "module": "ESNext",
    "sourceMap": true,
    "moduleResolution": "bundler",
    "target": "ES2023",
    "allowImportingTsExtensions": false,
    "isolatedModules": true,
    "allowJs": true,
    "strict": true,
    "outDir": "./docs",
    "skipLibCheck": true,
    "rootDirs": [
      "src"
    ],
    "paths": {
      "@ixfx/*": [
        "./node_modules/ixfx/dist/*"
      ]
    }
  },
  "exclude": [
    "node_modules",
    "**/node_modules/*",
    "docs/*"
  ]
}